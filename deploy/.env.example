# =============================================================
# WMS 部署环境变量模板
#
# 用法：在 ECS 上 /opt/wms/ 目录下，把本文件复制为 .env 并填真实值
#       cp .env.example .env && vim .env
#
# ⚠️ 重要：.env 里面有数据库密码和 JWT 密钥，
#          【绝对不能提交到 Git 仓库】，也不能发给任何人。
#          deploy/.gitignore 里已经把它排除掉了。
# =============================================================

# ---------- 阿里云 RDS MySQL ----------
# 填 RDS 的【内网地址】，形如 rm-xxxxxxxx.mysql.rds.aliyuncs.com
# 为什么用内网地址：ECS 和 RDS 在同一个地域时，
#   内网互通 → 延迟低（1ms 级）、不消耗公网流量、不计流量费。
#   用公网地址不仅慢，还可能产生费用，且 RDS 白名单要额外放行。
DB_HOST=rm-xxxxxxxxxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=wms_db
# 不要用 root！在 RDS 里单独建一个只对 wms_db 有权限的账号
DB_USERNAME=wms_app
DB_PASSWORD=在这里填你的RDS账号密码

# ---------- JWT 签名密钥 ----------
# 必须在服务器上生成一个随机值，命令：
#   openssl rand -base64 48
# 然后粘贴到下面。绝不能用代码里的默认值
# （默认值等于把签名钥匙公开写在 GitHub 上，谁都能伪造 token 登录）
JWT_SECRET=在这里填openssl生成的长随机串
# token 有效期，毫秒。28800000 = 8 小时
JWT_EXPIRATION=28800000
